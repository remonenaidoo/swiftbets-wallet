{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FaultInjection": {
    "Enabled": false
  },
  "Kafka": {
    "BootstrapServers": "",
    "Environment": "dev",
    "ClientId": "swiftbets-wallet"
  },
  "Jwt": {
    "Authority": "",
    "Audience": "swiftbets",
    "RequireHttpsMetadata": true
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  }
}
